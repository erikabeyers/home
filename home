<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>E. Beyers · Environmental Software Tools</title>

  <!-- Modern, slightly feminine sans-serif -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

  <style>
    :root{
      /* Earth tones */
      --bg: #1F2A24;          /* deep forest */
      --panel: #24332B;       /* moss */
      --panel2:#1A241F;       /* deeper moss */
      --sand:#E6D8C3;         /* warm sand */
      --clay:#D6C6AE;         /* soft clay */
      --linen:#F5F1EB;        /* off-white */
      --muted: rgba(245,241,235,.72);
      --muted2: rgba(245,241,235,.55);
      --stroke: rgba(214,198,174,.40);
      --stroke2: rgba(214,198,174,.22);
      --shadow: 0 10px 30px rgba(0,0,0,.22);
      --r-xl: 22px;
      --r-2xl: 28px;
    }

    *{ box-sizing:border-box; }
    html{ scroll-behavior:smooth; }
    body{
      margin:0;
      font-family:"DM Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: radial-gradient(1200px 500px at 50% -10%, rgba(230,216,195,.13), transparent 60%),
                  radial-gradient(700px 420px at 90% 40%, rgba(230,216,195,.08), transparent 55%),
                  var(--bg);
      color:var(--linen);
      letter-spacing:.01em;
    }

    a{ color:inherit; text-decoration:none; }
    .wrap{ max-width:1120px; margin:0 auto; padding:0 20px; }

    /* Utilities */
    .pill{ display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border-radius:999px; border:1px solid var(--stroke2); background:rgba(36,51,43,.55); color:var(--muted); font-size:12px; }
    .btn{ display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:12px 16px; border-radius:18px; border:1px solid var(--stroke2); background:rgba(36,51,43,.55); color:var(--linen); font-weight:500; }
    .btn:hover{ background:rgba(36,51,43,.75); }
    .btn-primary{ background:var(--sand); color: #1A241F; border-color: rgba(230,216,195,.55); }
    .btn-primary:hover{ filter:brightness(.98); }

    .card{ border-radius:var(--r-2xl); border:1px solid var(--stroke2); background:rgba(36,51,43,.55); box-shadow: var(--shadow); }
    .card-soft{ border-radius:var(--r-2xl); border:1px solid var(--stroke2); background:rgba(36,51,43,.38); }

    /* Top nav */
    .nav{
      position:sticky; top:0; z-index:50;
      border-bottom:1px solid var(--stroke2);
      background: rgba(31,42,36,.70);
      backdrop-filter: blur(10px);
    }
    .nav-inner{ display:flex; align-items:center; justify-content:space-between; padding:14px 0; }
    .brand{ display:flex; align-items:center; gap:12px; }
    .logo{
      width:38px; height:38px; display:grid; place-items:center;
      border-radius:14px; border:1px solid var(--stroke2);
      background: rgba(36,51,43,.55);
      font-size:18px;
    }
    .brand-name{ font-size:14px; font-weight:500; letter-spacing:.04em; }
    .brand-sub{ font-size:12px; color:var(--muted2); margin-top:2px; }

    .nav-links{ display:none; gap:6px; align-items:center; }
    .nav-links a, .nav-links button{
      font:inherit; cursor:pointer;
      border:0; background:transparent;
      padding:9px 12px; border-radius:999px;
      color:var(--muted);
    }
    .nav-links a:hover, .nav-links button:hover{ background:rgba(36,51,43,.55); color:var(--linen); }

    .nav-cta{ display:inline-flex; }

    @media (min-width: 720px){
      .nav-links{ display:flex; }
      .nav-cta.mobile{ display:none; }
    }
    @media (max-width: 719px){
      .nav-cta.desktop{ display:none; }
    }

    /* Hero */
    .hero{ padding: 56px 0 26px; }
    .hero-grid{ display:grid; gap:18px; }
    @media (min-width: 980px){
      .hero-grid{ grid-template-columns: 1.25fr .75fr; gap:28px; align-items:start; }
    }

    h1{ margin:14px 0 0; font-size:42px; line-height:1.05; font-weight:500; letter-spacing:.02em; }
    @media (min-width:720px){ h1{ font-size:54px; } }

    .lead{ margin:14px 0 0; max-width: 56ch; color: var(--muted); line-height:1.6; font-size:16px; }

    .badge-grid{ margin-top:22px; display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
    @media (min-width:720px){ .badge-grid{ grid-template-columns: repeat(4, 1fr); } }

    .badge{ display:flex; align-items:center; gap:10px; padding:12px 12px; border-radius:18px; border:1px solid var(--stroke2); background:rgba(36,51,43,.42); color:var(--muted); font-size:12px; }

    /* Sections */
    section{ padding: 42px 0; }
    .section-head{ max-width: 720px; }
    .eyebrow{ display:inline-flex; align-items:center; gap:8px; padding:7px 11px; border-radius:999px; border:1px solid var(--stroke2); background:rgba(36,51,43,.42); color:var(--muted); font-size:12px; }
    .h2{ margin:14px 0 0; font-size:28px; font-weight:500; letter-spacing:.03em; }
    .sub{ margin:10px 0 0; color:var(--muted); line-height:1.65; }

    /* Work filter */
    .filters{ margin-top:18px; display:flex; flex-direction:column; gap:12px; }
    @media (min-width:720px){ .filters{ flex-direction:row; align-items:center; justify-content:space-between; } }

    .search{ position:relative; width:100%; max-width:420px; }
    .search input{
      width:100%;
      padding:11px 12px 11px 40px;
      border-radius:18px;
      border:1px solid var(--stroke2);
      background:rgba(36,51,43,.45);
      color:var(--linen);
      outline:none;
    }
    .search input::placeholder{ color:rgba(245,241,235,.45); }
    .search svg{ position:absolute; left:14px; top:50%; transform:translateY(-50%); opacity:.7; }

    .cat-row{ display:flex; flex-wrap:wrap; gap:8px; }
    .chip{
      border-radius:999px;
      padding:8px 12px;
      border:1px solid var(--stroke2);
      background:rgba(36,51,43,.42);
      color:var(--muted);
      font:inherit;
      font-size:14px;
      cursor:pointer;
    }
    .chip:hover{ background:rgba(36,51,43,.60); color:var(--linen); }
    .chip.active{ background:var(--sand); border-color: rgba(230,216,195,.60); color:#1A241F; }

    /* Project cards */
    .grid{ margin-top:16px; display:grid; gap:14px; }
    @media (min-width:980px){ .grid{ grid-template-columns: 1fr 1fr; } }

    .p-card{ padding:18px; }
    .p-top{ display:flex; justify-content:space-between; gap:14px; align-items:flex-start; }
    .p-left{ display:flex; gap:12px; }
    .p-icon{ width:44px; height:44px; border-radius:18px; border:1px solid var(--stroke2); background:rgba(36,51,43,.55); display:grid; place-items:center; }
    .p-title{ font-size:18px; font-weight:500; letter-spacing:.03em; }
    .p-cat{ font-size:12px; color:var(--muted2); margin-top:2px; }
    .p-tagline{ margin-top:10px; color:var(--muted); }

    .impact{ display:none; padding:10px 12px; border-radius:18px; border:1px solid var(--stroke2); background:rgba(26,36,31,.55); color:var(--muted); font-size:12px; max-width: 260px; }
    @media (min-width:720px){ .impact{ display:block; } }

    .hl{ margin-top:14px; padding:14px; border-radius:22px; border:1px solid var(--stroke2); background:rgba(26,36,31,.55); }
    .hl h4{ margin:0; font-size:12px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; color:var(--muted2); }
    .hl ul{ margin:10px 0 0; padding:0; list-style:none; display:grid; gap:8px; }
    .hl li{ display:flex; gap:10px; color:var(--muted); line-height:1.45; }
    .dot{ width:7px; height:7px; border-radius:999px; background:rgba(230,216,195,.55); margin-top:7px; flex:0 0 auto; }

    .stack{ margin-top:14px; display:flex; flex-wrap:wrap; gap:8px; }

    .links{ margin-top:16px; display:flex; flex-wrap:wrap; gap:10px; }

    /* Contact */
    .contact{ padding:22px; }
    @media (min-width:980px){ .contact-grid{ display:grid; grid-template-columns: 1.2fr .8fr; gap:18px; } }

    label{ display:block; font-size:12px; color:var(--muted2); margin-top:14px; }
    input, textarea{
      width:100%;
      margin-top:8px;
      padding:11px 12px;
      border-radius:18px;
      border:1px solid var(--stroke2);
      background:rgba(36,51,43,.45);
      color:var(--linen);
      outline:none;
      font:inherit;
    }
    textarea{ resize:none; }

    /* Footer */
    footer{ border-top:1px solid var(--stroke2); padding: 20px 0; color: var(--muted2); }
    .foot{ display:flex; flex-direction:column; gap:10px; }
    @media (min-width:720px){ .foot{ flex-direction:row; align-items:center; justify-content:space-between; } }
    .foot a:hover{ color: var(--linen); }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce){
      html{ scroll-behavior:auto; }
    }
  </style>
</head>

