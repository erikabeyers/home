        ],
        links: { caseStudy:'#', demo:'#', repo:'#' },
        icon: '⚡'
      },
      {
        id: 'carbon-dashboard',
        title: 'Carbon Emissions Dashboard',
        tagline: 'Location-based physical energy usage insights for assets',
        category: 'Climate Data',
        impact: 'Enabled comparable screening across 25+ sites across Europe.',
        stack: ['Web', 'Microsoft Excel', 'Power BI'],
        highlights: [
          'Interactive maps linking details of site visit findings',
          'Facility condition assessment & sustainability tracking',
          'Custom report generation* and data export options'
        ],
        links: { caseStudy:'#', demo:'#', repo:'#' },
        icon: '🗺️'
      },
      {
        id: 'esg-api',
        title: 'ESG Data API',
        tagline: 'A unified interface for utilities, suppliers, and reports',
        category: 'Data Engineering',
        impact: 'Cut supplier data onboarding from weeks to days.',
        stack: ['Go', 'gRPC', 'Kafka', 'BigQuery'],
        highlights: [
          'Schema registry + versioning',
          'Quality rules + anomaly alerts',
          'Partner integrations + webhooks'
        ],
        links: { caseStudy:'#', demo:'#', repo:'#' },
        icon: '🔌'
      }
    ];

    // Build categories
    const catsEl = document.getElementById('cats');
    const categories = ['All', ...Array.from(new Set(projects.map(p => p.category)))];
    let activeCat = 'All';

    categories.forEach(cat => {
      const b = document.createElement('button');
      b.className = 'chip' + (cat === activeCat ? ' active' : '');
      b.type = 'button';
      b.textContent = cat;
      b.addEventListener('click', () => {
        activeCat = cat;
        document.querySelectorAll('.chip').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        render();
      });
      catsEl.appendChild(b);
    });

    // Render
    const qEl = document.getElementById('q');
    const listEl = document.getElementById('projects');

    function cardHTML(p){
      const stack = p.stack.map(s => `<span class="pill">${escapeHtml(s)}</span>`).join('');
      const hls = p.highlights.map(h => `
        <li><span class="dot"></span><span>${escapeHtml(h)}</span></li>
      `).join('');
      return `
        <article class="card p-card" data-id="${p.id}">
          <div class="p-top">
            <div>
              <div class="p-left">
                <div class="p-icon" aria-hidden="true">${p.icon}</div>
                <div>
                  <div class="p-title">${escapeHtml(p.title)}</div>
                  <div class="p-cat">${escapeHtml(p.category)}</div>
                </div>
              </div>
              <div class="p-tagline">${escapeHtml(p.tagline)}</div>
            </div>
            <div class="impact">${escapeHtml(p.impact)}</div>
          </div>

          <div class="hl">
            <h4>Highlights</h4>
            <ul>${hls}</ul>
          </div>

          <div class="stack">${stack}</div>

          <div class="links">
            <a class="btn btn-primary" href="${p.links.caseStudy}">Case study →</a>
            <a class="btn" href="${p.links.demo}">Live demo</a>
            <a class="btn" href="${p.links.repo}">Repo</a>
          </div>
        </article>
      `;
    }

    function render(){
      const q = (qEl.value || '').trim().toLowerCase();
      const filtered = projects.filter(p => {
        const blob = [p.title, p.tagline, p.category, p.impact, p.stack.join(' '), p.highlights.join(' ')].join(' ').toLowerCase();
        const matchesQ = !q || blob.includes(q);
        const matchesCat = activeCat === 'All' || p.category === activeCat;
        return matchesQ && matchesCat;
      });

      listEl.innerHTML = filtered.length
        ? filtered.map(cardHTML).join('')
        : `<div class="card" style="padding:18px; background:rgba(36,51,43,.45); color:var(--muted);">No projects match your search.</div>`;
    }

    qEl.addEventListener('input', render);

    // Helpers
    function escapeHtml(str){
      return String(str)
        .replaceAll('&','&amp;')
        .replaceAll('<','&lt;')
        .replaceAll('>','&gt;')
        .replaceAll('"','&quot;')
        .replaceAll("'",'&#39;');
    }

    document.getElementById('year').textContent = new Date().getFullYear();
    render();
  </script>
</body>
</html>


